<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>RoomBooking.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The web host comes from the shared framework: the tests start the real app on Kestrel. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="SpecTrace" Version="$(SpecTraceVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RoomBooking.Api\RoomBooking.Api.csproj" />
  </ItemGroup>
</Project>
